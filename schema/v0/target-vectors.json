{
  "title": "Open Food Log v0: target vectors",
  "description": "Worked cases every implementation should agree on (section 9 of the spec): which of targets applies to a day or a meal, and whether its total met it. target is the index of the entry that applies (null when none does), and status is met, under, above or unknown (null with no target). is_complete false means some item lacks the nutrient or the day may not be fully logged, so total is a lower bound.",
  "targets": {
    "$schema": "https://openfoodlog.org/schema/v0/targets.json",
    "ofl_version": "0.1",
    "targets": [
      {
        "nutrient": "protein_g",
        "per": "day",
        "min": 140,
        "effective_from": "2026-10-01",
        "set_by": "person"
      },
      {
        "nutrient": "protein_g",
        "per": "day",
        "min": 160,
        "effective_from": "2026-11-01",
        "set_by": "person",
        "note": "More while training for the meet."
      },
      {
        "nutrient": "energy_kcal",
        "per": "day",
        "target": 2600,
        "effective_from": "2026-11-01",
        "set_by": "professional"
      },
      {
        "nutrient": "energy_kcal",
        "per": "day",
        "target": 3000,
        "weekdays": [1, 3, 5],
        "effective_from": "2026-11-01",
        "set_by": "professional",
        "note": "Training days."
      },
      {
        "nutrient": "sodium_mg",
        "per": "day",
        "max": 2300,
        "effective_from": "2026-11-01",
        "set_by": "app_suggestion"
      },
      {
        "nutrient": "fiber_g",
        "per": "day",
        "min": 25,
        "max": 45,
        "target": 35,
        "effective_from": "2026-11-01",
        "effective_to": "2026-11-30",
        "set_by": "person"
      },
      {
        "nutrient": "protein_g",
        "per": "meal",
        "meal_type": "breakfast",
        "min": 30,
        "effective_from": "2026-11-01",
        "set_by": "person"
      },
      {
        "nutrient": "energy_kcal",
        "per": "day",
        "target": 2400,
        "effective_from": "2026-12-01",
        "set_by": "person",
        "note": "A new every-day target; the training-day one still holds on its days."
      }
    ]
  },
  "cases": [
    {
      "name": "a minimum met",
      "date": "2026-11-10",
      "nutrient": "protein_g",
      "per": "day",
      "total": 172.5,
      "is_complete": true,
      "expect": { "target": 1, "status": "met" }
    },
    {
      "name": "a minimum under",
      "date": "2026-11-10",
      "nutrient": "protein_g",
      "per": "day",
      "total": 120,
      "is_complete": true,
      "expect": { "target": 1, "status": "under" }
    },
    {
      "name": "the latest effective_from wins",
      "note": "140 applied in October; from November 1 it's 160.",
      "date": "2026-11-10",
      "nutrient": "protein_g",
      "per": "day",
      "total": 150,
      "is_complete": true,
      "expect": { "target": 1, "status": "under" }
    },
    {
      "name": "an older target still applies to its own days",
      "date": "2026-10-20",
      "nutrient": "protein_g",
      "per": "day",
      "total": 150,
      "is_complete": true,
      "expect": { "target": 0, "status": "met" }
    },
    {
      "name": "before any target",
      "date": "2026-09-30",
      "nutrient": "protein_g",
      "per": "day",
      "total": 150,
      "is_complete": true,
      "expect": { "target": null, "status": null }
    },
    {
      "name": "an incomplete total already over a minimum",
      "note": "A lower bound at or past the minimum is met whatever is missing.",
      "date": "2026-11-10",
      "nutrient": "protein_g",
      "per": "day",
      "total": 165,
      "is_complete": false,
      "expect": { "target": 1, "status": "met" }
    },
    {
      "name": "an incomplete total short of a minimum",
      "note": "What's missing might make up the difference, so it can't be called under.",
      "date": "2026-11-10",
      "nutrient": "protein_g",
      "per": "day",
      "total": 100,
      "is_complete": false,
      "expect": { "target": 1, "status": "unknown" }
    },
    {
      "name": "a target within tolerance",
      "note": "Tuesday: 2600 ± 10% is 2340 to 2860.",
      "date": "2026-11-10",
      "nutrient": "energy_kcal",
      "per": "day",
      "total": 2450,
      "is_complete": true,
      "expect": { "target": 2, "status": "met" }
    },
    {
      "name": "a target under its tolerance",
      "date": "2026-11-10",
      "nutrient": "energy_kcal",
      "per": "day",
      "total": 2300,
      "is_complete": true,
      "expect": { "target": 2, "status": "under" }
    },
    {
      "name": "a target above its tolerance",
      "date": "2026-11-10",
      "nutrient": "energy_kcal",
      "per": "day",
      "total": 2900,
      "is_complete": true,
      "expect": { "target": 2, "status": "above" }
    },
    {
      "name": "a weekday target over an every-day one",
      "note": "Monday is a training day: 3000 ± 10%.",
      "date": "2026-11-09",
      "nutrient": "energy_kcal",
      "per": "day",
      "total": 2900,
      "is_complete": true,
      "expect": { "target": 3, "status": "met" }
    },
    {
      "name": "a newer every-day target doesn't override a weekday one",
      "note": "Wednesday, December 2: the training-day target (3000) is more specific than December's every-day one.",
      "date": "2026-12-02",
      "nutrient": "energy_kcal",
      "per": "day",
      "total": 2900,
      "is_complete": true,
      "expect": { "target": 3, "status": "met" }
    },
    {
      "name": "a newer every-day target on other days",
      "note": "Tuesday: December's 2400 replaces November's 2600.",
      "date": "2026-12-01",
      "nutrient": "energy_kcal",
      "per": "day",
      "total": 2450,
      "is_complete": true,
      "expect": { "target": 7, "status": "met" }
    },
    {
      "name": "a maximum met",
      "date": "2026-11-10",
      "nutrient": "sodium_mg",
      "per": "day",
      "total": 1800,
      "is_complete": true,
      "expect": { "target": 4, "status": "met" }
    },
    {
      "name": "a maximum above",
      "date": "2026-11-10",
      "nutrient": "sodium_mg",
      "per": "day",
      "total": 2500,
      "is_complete": true,
      "expect": { "target": 4, "status": "above" }
    },
    {
      "name": "an incomplete total under a maximum",
      "note": "What's missing might take it over, so it can't be called met.",
      "date": "2026-11-10",
      "nutrient": "sodium_mg",
      "per": "day",
      "total": 1800,
      "is_complete": false,
      "expect": { "target": 4, "status": "unknown" }
    },
    {
      "name": "an incomplete total already above a maximum",
      "date": "2026-11-10",
      "nutrient": "sodium_mg",
      "per": "day",
      "total": 2500,
      "is_complete": false,
      "expect": { "target": 4, "status": "above" }
    },
    {
      "name": "min and max decide, target is the aim",
      "date": "2026-11-10",
      "nutrient": "fiber_g",
      "per": "day",
      "total": 27,
      "is_complete": true,
      "expect": { "target": 5, "status": "met" }
    },
    {
      "name": "past effective_to",
      "date": "2026-12-01",
      "nutrient": "fiber_g",
      "per": "day",
      "total": 30,
      "is_complete": true,
      "expect": { "target": null, "status": null }
    },
    {
      "name": "a meal target on its meal type",
      "date": "2026-11-10",
      "nutrient": "protein_g",
      "per": "meal",
      "meal_type": "breakfast",
      "total": 32,
      "is_complete": true,
      "expect": { "target": 6, "status": "met" }
    },
    {
      "name": "a meal target on another meal type",
      "date": "2026-11-10",
      "nutrient": "protein_g",
      "per": "meal",
      "meal_type": "lunch",
      "total": 20,
      "is_complete": true,
      "expect": { "target": null, "status": null }
    }
  ]
}
