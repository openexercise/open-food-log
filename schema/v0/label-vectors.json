{
  "title": "Open Food Log v0: label vectors",
  "description": "Worked labels every implementation should agree on (section 5 of the spec, v0.3). Each case is a package's label as printed (food.json's label) and, optionally, the food's density. A consistent label gives its food's values: with the serving's grams, nutrients_per_100g is nutrients_per_serving times 100 / grams and the serving is the default portion (serving_grams); with its ml, nutrients_per_100ml is the same over ml; with only ml, nutrients_basis is 100ml and nutrients_per_100g is empty unless density_g_per_ml is known, when it is per 100 ml over the density; with neither, nutrients_basis is serving and nutrients_per_100g is empty. An inconsistent label (label_inconsistent) declares a part more than the whole that includes it, listing every such part and whole; an implausible one (implausible) gives per 100 g or per 100 ml more than 900 kcal, or more than 100 g of protein, fat and carbohydrate together. Values are exact to four decimal places; within 0.01 agrees.",
  "cases": [
    {
      "name": "US bar, serving by weight",
      "note": "Per 100 g is per serving times 100 / 40. The serving becomes the default portion. The %DV is kept as printed and never turned into amounts.",
      "label": {
        "region": "us",
        "serving": {
          "text": "1 bar (40g)",
          "grams": 40
        },
        "servings_per_container": 6,
        "nutrients_per_serving": {
          "energy_kcal": 190,
          "fat_g": 7,
          "saturated_fat_g": 2.5,
          "trans_fat_g": 0,
          "sodium_mg": 140,
          "carbohydrate_g": 27,
          "fiber_g": 3,
          "sugars_g": 12,
          "added_sugars_g": 10,
          "protein_g": 4
        },
        "percent_daily_values": {
          "fat_g": 9,
          "saturated_fat_g": 13,
          "sodium_mg": 6,
          "carbohydrate_g": 10,
          "fiber_g": 11,
          "added_sugars_g": 20
        }
      },
      "expect": {
        "nutrients_basis": "100g",
        "nutrients_per_100g": {
          "energy_kcal": 475.0,
          "fat_g": 17.5,
          "saturated_fat_g": 6.25,
          "trans_fat_g": 0.0,
          "sodium_mg": 350.0,
          "carbohydrate_g": 67.5,
          "fiber_g": 7.5,
          "sugars_g": 30.0,
          "added_sugars_g": 25.0,
          "protein_g": 10.0
        },
        "serving_grams": 40
      }
    },
